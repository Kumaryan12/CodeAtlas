# Local development credentials only. Do not reuse for deployed environments.
POSTGRES_USER=codeatlas
POSTGRES_PASSWORD=codeatlas_local
POSTGRES_DB=codeatlas
POSTGRES_PORT=5432
CODEATLAS_DATABASE_URL=postgresql+psycopg://codeatlas:codeatlas_local@localhost:5432/codeatlas
# Read by Next.js on the server, never exposed as a public environment variable.
API_BASE_URL=http://127.0.0.1:8000
# Bounded synchronous ingestion. Keep the API on one worker for this milestone.
CODEATLAS_MAX_DOWNLOAD_BYTES=20971520
CODEATLAS_DOWNLOAD_TIMEOUT_SECONDS=45
CODEATLAS_ANALYSIS_TIMEOUT_SECONDS=60
# Optional absolute directory; defaults to <project>/workspaces.
# CODEATLAS_WORKSPACE_ROOT=/absolute/path/to/workspaces
# Optional AI. Keys remain on the API server; never use NEXT_PUBLIC_.
# Claude is the default for answers and agent decisions.
CODEATLAS_REASONING_PROVIDER=anthropic
CODEATLAS_ANTHROPIC_API_KEY=
# Optional model override; omit to use the provider default (Claude Sonnet 5).
# CODEATLAS_ANSWER_MODEL=claude-sonnet-5
# Optional OpenAI embeddings; used only when CODEATLAS_EMBEDDING_PROVIDER=openai.
CODEATLAS_OPENAI_API_KEY=
CODEATLAS_EMBEDDING_MODEL=text-embedding-3-small
# Optional sandbox tests: build both trusted images first (see README).
# Test execution also requires an explicit per-run profile or a manual Run tests action.
CODEATLAS_SANDBOX_ENABLED=false

# Route four snapshot read tools through the bundled, scoped MCP stdio server.
# Set local to use the direct Python handlers. Search/drafts/tests remain local.
CODEATLAS_READ_TOOL_TRANSPORT=mcp

# Optional USD-per-million token rates keyed by "provider:model". Empty = unknown cost.
# See docs/agent-evaluation.md; rates are operator supplied, not fetched automatically.
CODEATLAS_USAGE_PRICES={}

# Embeddings run locally; Claude remains the answer provider.
CODEATLAS_EMBEDDING_PROVIDER=local
